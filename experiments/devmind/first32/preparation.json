{
  "format": "sparselab-preparation-v1",
  "defaults": {
    "MAX_INPUT_BYTES": "104857600"
  },
  "phases": {
    "derive-subset": {
      "leaf": null,
      "args": [
        "corpus",
        "acquire",
        "${ACQUISITION_PROJECT}"
      ]
    },
    "verify-subset": {
      "leaf": null,
      "args": [
        "corpus",
        "acquire",
        "${ACQUISITION_PROJECT}",
        "--offline"
      ]
    },
    "admission-draft": {
      "leaf": "admission-draft.json",
      "args": [
        "corpus",
        "admission-draft",
        "${ACQUISITION_PROJECT}",
        "--template",
        "${APPLICATION_POLICY}",
        "--policy-document",
        "${POLICY_DOCUMENT}",
        "--output",
        "@admission-draft"
      ]
    },
    "admission-inspection": {
      "leaf": "admission-inspection.json",
      "args": [
        "corpus",
        "inspect-admission",
        "${ACQUISITION_PROJECT}",
        "--draft",
        "@admission-draft",
        "--policy-document",
        "${POLICY_DOCUMENT}",
        "--selection",
        "${INSPECTION_SELECTION}",
        "--output",
        "@admission-inspection",
        "--max-input-bytes",
        "${MAX_INPUT_BYTES}",
        "--max-excerpt-bytes",
        "1024",
        "--max-output-bytes",
        "2097152"
      ]
    },
    "split-inventory": {
      "leaf": "split-inventory.jsonl",
      "args": [
        "corpus",
        "split-inventory",
        "${PRE_FREEZE_PROJECT}",
        "--output",
        "@split-inventory",
        "--json"
      ]
    },
    "freeze-splits": {
      "leaf": "splits-reviewed.yaml",
      "args": [
        "corpus",
        "freeze-splits",
        "${PRE_FREEZE_PROJECT}",
        "--inventory",
        "@split-inventory",
        "--clusters",
        "${REVIEWED_CLUSTERS}",
        "--output",
        "@freeze-splits",
        "--json"
      ]
    },
    "build": {
      "leaf": null,
      "args": [
        "corpus",
        "build",
        "${BUILD_PROJECT}",
        "--offline"
      ]
    },
    "freeze-release": {
      "leaf": null,
      "args": [
        "corpus",
        "freeze",
        "${BUILD_RESULT}"
      ]
    },
    "family-inventory": {
      "leaf": "family-inventory.jsonl",
      "args": [
        "corpus",
        "finalize-family-inventory",
        "${RELEASE}",
        "--splits",
        "@freeze-splits",
        "--output",
        "@family-inventory",
        "--json"
      ]
    },
    "audit-release": {
      "leaf": null,
      "args": [
        "corpus",
        "audit",
        "${RELEASE}"
      ]
    },
    "export-lm": {
      "leaf": null,
      "args": [
        "corpus",
        "export",
        "${RELEASE}",
        "--view",
        "lm",
        "--base-run-config",
        "${BASE_RUN_CONFIG}",
        "--vocab-size",
        "32768",
        "--min-frequency",
        "1"
      ]
    },
    "fit-tokenizer": {
      "leaf": null,
      "args": [
        "tokenizer",
        "train",
        "${TOKENIZER_CONFIG}"
      ]
    },
    "measure-tokens": {
      "leaf": "token-measurements.json",
      "args": [
        "corpus",
        "measure-tokens",
        "${RELEASE}",
        "--tokenizer",
        "${TOKENIZER}",
        "--tokenizer-origin-release",
        "${RELEASE}",
        "--family-inventory",
        "@family-inventory",
        "--policy",
        "${TOKEN_FLOORS}",
        "--output",
        "@measure-tokens",
        "--batch-source-bytes",
        "8388608",
        "--json"
      ]
    },
    "materialize-unique": {
      "leaf": "unique-mixture",
      "args": [
        "corpus",
        "materialize-mixture",
        "${MIXTURE_DECLARATION}",
        "--output",
        "@materialize-unique",
        "--json"
      ]
    },
    "verify-unique": {
      "leaf": null,
      "args": [
        "corpus",
        "verify-mixture",
        "${MIXTURE_DECLARATION}",
        "--output",
        "@materialize-unique",
        "--json"
      ]
    },
    "pack": {
      "leaf": "prepared-inputs",
      "args": [
        "data",
        "prepared-inputs",
        "publish",
        "${RUN_CONFIG}",
        "--output",
        "@pack",
        "--resource-envelope",
        "${RESOURCE_ENVELOPE}",
        "--tokenizer-batch-source-bytes",
        "8388608"
      ]
    },
    "verify-prepared": {
      "leaf": null,
      "args": [
        "data",
        "prepared-inputs",
        "verify",
        "${RUN_CONFIG}",
        "@pack"
      ]
    }
  }
}
