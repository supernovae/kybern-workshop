{
  "campaign_version": 1,
  "id": "tinystories-useful-preparation-v1",
  "stages": [
    {
      "id": "snapshot",
      "kind": "dataset_snapshot",
      "scope": "corpus",
      "lock": "source.lock.json",
      "output": "snapshot",
      "cache_dir": "acquisition-cache"
    },
    {
      "id": "train-tokenizer",
      "kind": "tokenizer_train",
      "scope": "tokenizer",
      "config": "tokenizer.json",
      "snapshot": "snapshot",
      "requires": [
        "snapshot"
      ]
    },
    {
      "id": "pack-data",
      "kind": "data_prepare",
      "scope": "model",
      "requires": [
        "snapshot",
        "train-tokenizer"
      ],
      "config": "run.json",
      "tokenizer": "train-tokenizer",
      "snapshot": "snapshot"
    }
  ]
}
