{
  "plan_version": 1,
  "id": "tinystories-worker-pair",
  "base_run": "run.json",
  "inputs": {
    "tokenizer": "token",
    "prepared_data": "packed"
  },
  "evaluation_suite": "suite.json",
  "execution": {
    "backend": "cpu"
  },
  "axes": [
    {
      "name": "arm",
      "choices": [
        {
          "label": "baseline",
          "set": {
            "model.ffn_dim": 64
          }
        },
        {
          "label": "candidate",
          "set": {
            "model.ffn_dim": 96
          }
        }
      ]
    }
  ],
  "comparisons": [
    {
      "id": "ffn-width",
      "baseline": {
        "arm": "baseline"
      },
      "variant": {
        "arm": "candidate"
      },
      "mode": "controlled",
      "interventions": [
        "model.ffn_dim"
      ],
      "invariants": [
        "seed",
        "training.max_steps",
        "evaluation.max_batches"
      ]
    }
  ]
}
